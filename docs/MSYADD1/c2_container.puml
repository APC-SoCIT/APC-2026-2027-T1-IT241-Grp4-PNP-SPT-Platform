@startuml C2_Container
!include <C4/C4_Container>

title C2 - Container Diagram: SPT Platform

Person(trainee, "PNP Trainee")
Person(supervisor, "Supervisor")
Person(admin, "Admin")

System_Boundary(spt, "SPT Platform") {
    Container(web, "Web Application", "Laravel + Vue", "Screens and logic for learning, content, and accounts")
    ContainerDb(db, "Database", "TiDB Cloud", "Users, modules, progress, scores")
    ContainerDb(files, "File Storage", "AWS S3", "Module files and certificates")
}

System_Ext(chatbot, "AI Chatbot", "Lesson guidance")
System_Ext(email, "Email Service", "Brevo")
System_Ext(auth, "Google Authenticator", "2FA codes")

Rel(trainee, web, "Uses", "HTTPS")
Rel(supervisor, web, "Uses", "HTTPS")
Rel(admin, web, "Uses", "HTTPS")

Rel(web, db, "Reads and writes")
Rel(web, files, "Stores and gets files")
Rel(web, chatbot, "Asks questions")
Rel(web, email, "Sends emails")
Rel(web, auth, "Checks 2FA code")

@enduml