@startuml C3_Component
!include <C4/C4_Component>

title C3 - Component Diagram: Web Application

Person(trainee, "PNP Trainee")
Person(supervisor, "Supervisor")
Person(admin, "Admin")

ContainerDb(db, "Database", "TiDB Cloud")
ContainerDb(files, "File Storage", "AWS S3")
System_Ext(chatbot, "AI Chatbot")
System_Ext(email, "Email Service")
System_Ext(auth, "Google Authenticator")

Container_Boundary(web, "Web Application") {
    Component(account, "Account Manager", "Register, login, 2FA, profile, password reset")
    Component(access, "Role Access", "Sends each role to the right dashboard")
    Component(learn, "Learning", "Lessons and progress saving")
    Component(assess, "Assessment", "Final exam, grading, certificates")
    Component(monitor, "Progress Monitor", "Trainee and supervisor progress views")
    Component(content, "Content Manager", "Create and edit courses, modules, lessons")
    Component(platform, "Platform Admin", "Staff accounts, lock/unlock, analytics")
    Component(assistant, "Learning Assistant", "Links lessons to the AI Chatbot")
    Component(notify, "Notifications", "Builds and sends emails")
}

Rel(trainee, access, "Opens")
Rel(supervisor, access, "Opens")
Rel(admin, access, "Opens")

Rel(access, account, "Requires login")
Rel(access, learn, "Trainee")
Rel(access, monitor, "Trainee, Supervisor")
Rel(access, content, "Supervisor, Admin")
Rel(access, platform, "Admin")

Rel(learn, assess, "Unlocks after lessons")
Rel(learn, assistant, "Asks for help")
Rel(assistant, chatbot, "Sends question")
Rel(content, assistant, "Provides approved content")

Rel(account, auth, "Verifies code")
Rel(account, notify, "Requests emails")
Rel(notify, email, "Sends")

Rel(learn, db, "Saves progress")
Rel(assess, db, "Saves scores")
Rel(monitor, db, "Reads progress")
Rel(account, db, "Reads and writes users")
Rel(platform, db, "Updates accounts")
Rel(content, db, "Saves content")
Rel(content, files, "Uploads files")
Rel(assess, files, "Saves certificates")

@enduml