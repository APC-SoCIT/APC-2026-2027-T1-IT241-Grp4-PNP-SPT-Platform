@startuml System_Context_Diagram_for_PNP-SPT_Platform
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title C1: Context Diagram for PNP-SPT Platform

Person(trainees, "PNP Trainees")
Person(supervisor, "Supervisor")
Person(admin, "Admin")

System(sptPlatform, "PNP-SPT Platform")
System_Ext(aiChatbot, "AI Chatbot API")
SystemDb(sptDb, "SPT Database")

' Users to System (Combined Core and Extended Use Cases)
Rel(trainees, sptPlatform, "Learn module, monitor progress\n<<extend>> Take assessment", "HTTPS")
Rel(supervisor, sptPlatform, "Manage training content, monitor progress\n<<extend>> Create/manage modules", "HTTPS")
Rel(admin, sptPlatform, "Manage platform\n<<extend>> Account management", "HTTPS")

' System to External AI (Combined Send/Receive)
Rel(sptPlatform, aiChatbot, "Sends queries & context\n<-- Returns AI guidance", "API / JSON")

' System to Database
Rel(sptPlatform, sptDb, "Reads/writes platform data", "SQL")

SHOW_LEGEND()
@enduml
