@startuml Container_Diagram_for_PNP-SPT_Platform
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram for PNP-SPT Platform

Person(trainees, "PNP Trainees", "Register and log in, complete self-paced training modules, use the AI tutor, and claim certificates.")
Person(supervisor, "Supervisor", "Manages training content and monitors trainee progress.")
Person(admin, "Admin", "IT Department. Manages platform infrastructure and the AI chatbot integration.")

System_Boundary(sptPlatform, "PNP-SPT Platform") {
    Container(webApp, "Web Application", "Laravel 11, PHP 8.2", "Serves the training UI, delivers modules, tracks trainee progress, and generates barcode-verifiable certificates.")
    ContainerDb(sptDb, "SPT Database", "MySQL 9.1", "Stores curriculum content, trainee progress, and certificate records.")
}

System_Ext(aiChatbot, "AI Chatbot", "Approved third-party AI API acting as a real-time virtual tutor, restricted to curriculum-scoped content only.")
System_Ext(poa, "Police Officer Academy (POA)", "PNP's existing e-learning platform. Not connected — shown for reference only, since the platform is technically capable of future integration but no live connection exists during development or at handover.")

Rel(trainees, webApp, "Registers, logs in, completes modules, queries AI tutor", "HTTPS")
Rel(supervisor, webApp, "Manages training content, monitors progress dashboard", "HTTPS")
Rel(admin, webApp, "Configures infrastructure and AI chatbot integration", "HTTPS")

Rel(webApp, sptDb, "Reads/writes curriculum, progress, and certificate data", "SQL")

Rel(webApp, aiChatbot, "Sends curriculum-scoped prompts (no PII)", "API/JSON")
Rel(aiChatbot, webApp, "Returns contextual tutoring responses", "API/JSON")

SHOW_LEGEND()
@enduml
