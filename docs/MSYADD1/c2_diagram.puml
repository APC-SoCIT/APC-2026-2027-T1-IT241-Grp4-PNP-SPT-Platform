@startuml System_Container_Diagram_for_PNP-SPT_Platform
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()
title C2: Container Diagram for PNP-SPT Platform
Person(personnel, "PNP Personnel", "Law enforcement officers completing the standardized 7-module AI literacy curriculum.")
Person(admin, "Admin", "Supervisor and IT Department staff who manage training content, monitor workforce completion, verify certificates, and configure the AI assistant's scope.")
System_Boundary(sptPlatform, "PNP-SPT Platform") {
  Container(webApp, "Web Application", "Laravel 11, PHP 8.2", "Handles registration, authentication, course delivery, exam engine, admin dashboard, and AI prompt routing.")
  ContainerDb(db, "Database", "MySQL 9.1", "Stores curriculum content, progress records, exam results, and certificate hashes.")
  Container(fileStorage, "File Storage", "File Storage", "Stores scannable, verifiable certificate PDFs and course materials.")
}
System_Ext(poaPlatform, "Police Officer Academy (POA)", "PNP's existing centralized e-learning platform. No live connection exists during development or at handover. Shown here only to represent the platform's future integration capacity.")
System_Ext(aiChatbot, "Third-Party AI Assistant", "Approved external AI API acting as a real-time virtual tutor, restricted to approved educational content only.")
Rel(personnel, webApp, "Registers / logs in with own account, completes modules and exams, queries AI tutor", "HTTPS")
Rel(admin, webApp, "Manages training content, configures AI assistant scope, views workforce dashboard, verifies certificates", "HTTPS")
Rel(webApp, db, "Reads/writes curriculum, progress, and certificate data", "SQL / Eloquent ORM")
Rel(webApp, fileStorage, "Stores/retrieves certificate PDFs and course materials", "File I/O")
Rel(webApp, aiChatbot, "Sends course-related prompts (no PII)", "API / JSON")
Rel(aiChatbot, webApp, "Returns contextual tutoring responses", "API / JSON")
Rel_D(webApp, poaPlatform, "No active connection — same technology stack maintained for future integration", "N/A")
SHOW_LEGEND()
@enduml
